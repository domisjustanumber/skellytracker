{
  "$defs": {
    "AssignKeypointsNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/AssignKeypointsParams"
        },
        "type": {
          "const": "assign_keypoints",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "AssignKeypointsNode",
      "type": "object"
    },
    "AssignKeypointsParams": {
      "additionalProperties": false,
      "properties": {
        "map": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Target point to slot point `<slot>/<point>`, where `<point>` is a point of `source`. A present slot point replaces the target point.",
          "set_during_run": false,
          "source": "ADR-KW76 item 4",
          "title": "Map",
          "type": "object"
        },
        "max_distance": {
          "description": "The largest anchor distance, as a part of the diagonal of the box around the present points of the target row.",
          "exclusiveMinimum": 0.0,
          "set_during_run": true,
          "source": "ADR-KW76 item 6",
          "title": "Max Distance",
          "type": "number"
        },
        "slots": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Slot name to the target point that anchors the slot, for example `left_hand: body/left_wrist`. A slot with the name of a group of `target` replaces that group. A slot with another name adds a group.",
          "minProperties": 1,
          "set_during_run": false,
          "source": "ADR-KW76 items 2 and 3",
          "title": "Slots",
          "type": "object"
        },
        "source_anchor": {
          "description": "The point of `source` that the node compares with the slot anchors, for example `hand/root`.",
          "set_during_run": false,
          "source": "ADR-KW76 item 6",
          "title": "Source Anchor",
          "type": "string"
        }
      },
      "required": [
        "slots",
        "source_anchor",
        "max_distance"
      ],
      "title": "AssignKeypointsParams",
      "type": "object"
    },
    "BoxesFromPointsNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/BoxesFromPointsParams"
        },
        "type": {
          "const": "boxes_from_points",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "BoxesFromPointsNode",
      "type": "object"
    },
    "BoxesFromPointsParams": {
      "additionalProperties": false,
      "properties": {
        "alignment_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The end point of the alignment rule.",
          "set_during_run": false,
          "source": "ADR-7NY2 item 6",
          "title": "Alignment End"
        },
        "alignment_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The start point of the alignment rule.",
          "set_during_run": false,
          "source": "ADR-7NY2 item 6",
          "title": "Alignment Start"
        },
        "derived_points": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              }
            ]
          },
          "description": "Derived point name to derivation, in the map form of the sidecar `keypoint.derived_points`: passthrough, mean or weighted.",
          "set_during_run": false,
          "source": "ADR-7NY2 item 6; ADR-88WQ item 6",
          "title": "Derived Points",
          "type": "object"
        },
        "expand_ratio": {
          "default": 1.0,
          "description": "Multiply the width and the height by this value.",
          "exclusiveMinimum": 0.0,
          "set_during_run": true,
          "source": "MediaPipe RectTransformationCalculator scale default; ADR-88WQ item 4",
          "title": "Expand Ratio",
          "type": "number"
        },
        "min_previous_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The smallest width and height, as a part of the box of `previous_boxes`. Empty: no floor.",
          "set_during_run": true,
          "source": "BBoxPolicyConfig.min_shrink_ratio_per_frame; ADR-RA0E item 3",
          "title": "Min Previous Ratio"
        },
        "min_reference_ratio": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The smallest width and height, as a part of the box of `reference_boxes`. Empty: no floor.",
          "set_during_run": true,
          "source": "BBoxPolicyConfig.min_detected_bbox_ratio; ADR-RA0E item 3",
          "title": "Min Reference Ratio"
        },
        "min_size_px": {
          "default": 0.0,
          "description": "The smallest width and height, in source-image pixels.",
          "minimum": 0.0,
          "set_during_run": true,
          "source": "BBoxPolicyConfig.min_bbox_size_px; ADR-RA0E item 3",
          "title": "Min Size Px",
          "type": "number"
        },
        "points": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The points of the box. A list of names is one point with aliases: the first present name counts. Empty: each present point of the input.",
          "set_during_run": false,
          "source": "ADR-7NY2 item 6; ADR-RA0E item 2",
          "title": "Points"
        },
        "score_threshold": {
          "default": 0.0,
          "description": "A point counts only when its score is greater than this value.",
          "minimum": 0.0,
          "set_during_run": true,
          "source": "ADR-7NY2 item 6; ADR-88WQ item 6",
          "title": "Score Threshold",
          "type": "number"
        },
        "shift_x": {
          "default": 0.0,
          "description": "Shift along the box x axis, in box widths.",
          "set_during_run": true,
          "source": "MediaPipe RectTransformationCalculator default",
          "title": "Shift X",
          "type": "number"
        },
        "shift_y": {
          "default": 0.0,
          "description": "Shift along the box y axis, in box heights.",
          "set_during_run": true,
          "source": "MediaPipe RectTransformationCalculator default",
          "title": "Shift Y",
          "type": "number"
        },
        "size_rule": {
          "default": "bounds",
          "description": "`bounds`: the box around the points. `alignment`: centre at the start point, size 2 \u00d7 the distance from start to end.",
          "enum": [
            "bounds",
            "alignment"
          ],
          "set_during_run": false,
          "source": "MediaPipe AlignmentPointsRectsCalculator; ADR-7NY2 item 6",
          "title": "Size Rule",
          "type": "string"
        },
        "square_long": {
          "default": false,
          "description": "Make the box square with its longer side.",
          "set_during_run": true,
          "source": "MediaPipe RectTransformationCalculator default",
          "title": "Square Long",
          "type": "boolean"
        },
        "target_rotation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The rotation target in degrees. Empty: rotation `none`, an axis-aligned box.",
          "set_during_run": false,
          "source": "MediaPipe rect rotation; ADR-7NY2 item 6",
          "title": "Target Rotation Deg"
        }
      },
      "title": "BoxesFromPointsParams",
      "type": "object"
    },
    "FirstOfNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "description": "A list of `<node>.<port>`, each with an optional `@prev`. At least one item.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        },
        "type": {
          "const": "first_of",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "FirstOfNode",
      "type": "object"
    },
    "FitnessCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "description": "The check. A check that fails asks for a new detection.",
          "enum": [
            "min_keypoint_score",
            "keypoints_within_bbox_ratio",
            "max_frames_without_redetect",
            "bbox_area_collapse",
            "box_missing"
          ],
          "title": "Check",
          "type": "string"
        },
        "expand_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bbox_area_collapse (1.10).",
          "title": "Expand Ratio"
        },
        "min_area_ratio": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bbox_area_collapse (0.25).",
          "title": "Min Area Ratio"
        },
        "min_score": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bbox_area_collapse (0.0).",
          "title": "Min Score"
        },
        "n_frames": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "max_frames_without_redetect (30).",
          "title": "N Frames"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "min_keypoint_score (0.3) or keypoints_within_bbox_ratio (0.5).",
          "title": "Threshold"
        }
      },
      "required": [
        "check"
      ],
      "title": "FitnessCheck",
      "type": "object"
    },
    "FlagWhenNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/FlagWhenParams"
        },
        "type": {
          "const": "flag_when",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "FlagWhenNode",
      "type": "object"
    },
    "FlagWhenParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "The test on all present rows of `value`, as step 2 of `gate`: `is_empty`, `is_present` or `score_above`.",
          "enum": [
            "is_present",
            "is_empty",
            "score_above"
          ],
          "set_during_run": false,
          "source": "ADR-9HTX item 8",
          "title": "Mode",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The score threshold of the mode `score_above`.",
          "set_during_run": true,
          "source": "ADR-9HTX item 8",
          "title": "Threshold"
        }
      },
      "required": [
        "mode"
      ],
      "title": "FlagWhenParams",
      "type": "object"
    },
    "GateNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/GateParams"
        },
        "type": {
          "const": "gate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "GateNode",
      "type": "object"
    },
    "GateParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "Pass `value` when `condition` is empty, is present, or has a score greater than `threshold` (a boxes or keypoints condition), or when the flag `condition` is true or false.",
          "enum": [
            "is_empty",
            "is_present",
            "score_above",
            "is_true",
            "is_false"
          ],
          "set_during_run": false,
          "source": "ADR-7NY2 item 6; ADR-9HTX item 9",
          "title": "Mode",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The score threshold of the mode `score_above`.",
          "set_during_run": true,
          "source": "ADR-7NY2 item 6; ADR-88WQ item 6",
          "title": "Threshold"
        }
      },
      "required": [
        "mode"
      ],
      "title": "GateParams",
      "type": "object"
    },
    "HoldBoxesNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/HoldBoxesParams"
        },
        "type": {
          "const": "hold_boxes",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "HoldBoxesNode",
      "type": "object"
    },
    "HoldBoxesParams": {
      "additionalProperties": false,
      "properties": {
        "keypoint_margin": {
          "default": -0.1,
          "description": "Each previous point must be inside the new box grown by this part (negative: shrunk).",
          "set_during_run": true,
          "source": "MediaPipe Holistic hand RoiTrackingCalculator (face: -0.2)",
          "title": "Keypoint Margin",
          "type": "number"
        },
        "max_offset": {
          "default": 0.2,
          "description": "The largest x and y offset, as a part of the new box size.",
          "minimum": 0.0,
          "set_during_run": true,
          "source": "MediaPipe Holistic hand RoiTrackingCalculator (face: 0.1)",
          "title": "Max Offset",
          "type": "number"
        },
        "max_rotation_deg": {
          "default": 40.0,
          "description": "Keep the previous box only when the rotation differs by this much or less.",
          "minimum": 0.0,
          "set_during_run": true,
          "source": "MediaPipe Holistic hand RoiTrackingCalculator (face: 15)",
          "title": "Max Rotation Deg",
          "type": "number"
        },
        "max_size_change": {
          "default": 0.4,
          "description": "The largest width and height difference, as a part of the new box size.",
          "minimum": 0.0,
          "set_during_run": true,
          "source": "MediaPipe Holistic hand RoiTrackingCalculator (face: 0.3)",
          "title": "Max Size Change",
          "type": "number"
        }
      },
      "title": "HoldBoxesParams",
      "type": "object"
    },
    "Instrumentation": {
      "additionalProperties": false,
      "properties": {
        "taps": {
          "description": "The record and replay taps.",
          "items": {
            "$ref": "#/$defs/Tap"
          },
          "title": "Taps",
          "type": "array"
        },
        "timing_spans": {
          "description": "`<node>.<span>`, `pipeline.run`, `frame.decode` or `frame.upload`. Empty: no timing span is on.",
          "items": {
            "type": "string"
          },
          "title": "Timing Spans",
          "type": "array"
        }
      },
      "title": "Instrumentation",
      "type": "object"
    },
    "MediapipeTasksNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/MediapipeTasksParams"
        },
        "type": {
          "const": "mediapipe_tasks",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "MediapipeTasksNode",
      "type": "object"
    },
    "MediapipeTasksParams": {
      "additionalProperties": false,
      "properties": {
        "max_instances": {
          "default": 1,
          "description": "`num_poses`, `num_hands` or `num_faces`. Holistic is single person: 1.",
          "minimum": 1,
          "set_during_run": false,
          "source": "MediaPipe `num_poses`, `num_hands`, `num_faces` (Tasks default 1); ADR-V7GZ item 4",
          "title": "Max Instances",
          "type": "integer"
        },
        "min_detection_score": {
          "default": 0.5,
          "description": "The minimum detection score (Holistic: the pose and the face detection).",
          "maximum": 1.0,
          "minimum": 0.0,
          "set_during_run": false,
          "source": "MediaPipe `min_*_detection_confidence` (Tasks default 0.5)",
          "title": "Min Detection Score",
          "type": "number"
        },
        "min_presence_score": {
          "default": 0.5,
          "description": "The minimum presence score (Holistic: the landmark score of each part).",
          "maximum": 1.0,
          "minimum": 0.0,
          "set_during_run": false,
          "source": "MediaPipe `min_*_presence_confidence`, Holistic `min_*_landmarks_confidence` (Tasks default 0.5)",
          "title": "Min Presence Score",
          "type": "number"
        },
        "min_tracking_score": {
          "default": 0.5,
          "description": "The minimum tracking score in VIDEO mode. Holistic has no tracking option.",
          "maximum": 1.0,
          "minimum": 0.0,
          "set_during_run": false,
          "source": "MediaPipe `min_tracking_confidence` (Tasks default 0.5)",
          "title": "Min Tracking Score",
          "type": "number"
        },
        "size": {
          "default": "heavy",
          "description": "The model size of the pose landmarker. Only the variant `body` takes it (V-node.mediapipe_tasks-2).",
          "enum": [
            "lite",
            "full",
            "heavy"
          ],
          "set_during_run": false,
          "source": "MediaPipe asset `pose_landmarker_<size>`; MediapipePoseDetectorConfig.model_complexity",
          "title": "Size",
          "type": "string"
        },
        "variant": {
          "description": "The Tasks landmarker: pose (`body`), hand, face or holistic.",
          "enum": [
            "body",
            "hand",
            "face",
            "holistic"
          ],
          "set_during_run": false,
          "source": "ADR-V7GZ item 4; ADR-88WQ item 4",
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant"
      ],
      "title": "MediapipeTasksParams",
      "type": "object"
    },
    "MergeNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "description": "Text for people about the node. It can have more than one line.",
          "title": "Description",
          "type": "string"
        },
        "id": {
