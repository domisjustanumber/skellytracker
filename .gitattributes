# Auto detect text files. Each text file has LF line endings in the index and in the
# working tree on every machine. The eol attribute overrides core.autocrlf.
* text=auto eol=lf

# Sidecars and fragments are hashed byte for byte, so they must have LF line endings
# on every machine (see decisions/entries/0016-sidecar-catalogs.md).
*.yaml text eol=lf
*.yml text eol=lf
specs/model-sidecar/TRACEABILITY.md text eol=lf

# Proposal records and reference modules are byte copies of hashed bundle files.
# Git must not change their line endings.
specs/model-sidecar/proposals/** -text
specs/model-sidecar/reference/** -text
