          ],
          "default": null,
          "description": "Clear the filter state of a row after this many milliseconds with no valid point. Empty: no reset.",
          "live": false,
          "source": "KeypointResetPolicyConfig",
          "title": "Reset After Ms"
        }
      },
      "title": "SmoothKeypointsParams",
      "type": "object"
