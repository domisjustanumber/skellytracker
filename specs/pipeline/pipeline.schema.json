{
  "$defs": {
    "ConcatNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "description": "A list of `<node>.<port>`, each with an optional `@prev`. At least one item.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        },
        "type": {
          "const": "concat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "ConcatNode",
      "type": "object"
    },
    "DetectorNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/DetectorParams"
        },
        "type": {
          "const": "detector",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "DetectorNode",
      "type": "object"
    },
    "DetectorParams": {
      "additionalProperties": false,
      "properties": {
        "execution_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A concrete EP for this node. Empty: the EP of the run.",
          "live": false,
          "source": "ADR-7NY2 item 12",
          "title": "Execution Provider"
        },
        "key": {
          "description": "The catalog key of the model, `<model_id>@<source.name>`, with an optional pin `==<version>`.",
          "live": false,
          "source": "ADR-7NY2 item 10; ADR-88WQ item 7",
          "title": "Key",
          "type": "string"
        },
        "max_instances": {
          "default": 1,
          "description": "The number of instance rows `I` that this node makes (object detector or one-stage model).",
          "live": false,
          "minimum": 1,
          "source": "ADR-99MH item 1",
          "title": "Max Instances",
          "type": "integer"
        },
        "object_decode": {
          "additionalProperties": true,
          "description": "Changes of the fields of the `object.decode` block of the sidecar. The load checks each name against the sidecar.",
          "live": false,
          "source": "ADR-7NY2 item 11; ADR-88WQ item 7",
          "title": "Object Decode",
          "type": "object"
        },
        "precision": {
          "anyOf": [
            {
              "enum": [
                "fp32",
                "fp16"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The precision of the artifact. Empty: fp16 on a GPU EP and fp32 on CPU; fp32 when the size has no fp16 artifact.",
          "live": false,
          "source": "ADR-7NY2 item 10",
          "title": "Precision"
        },
        "sidecar_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The SHA-256 of the sidecar file bytes. Required in a shipped or an exported file.",
          "live": false,
          "source": "ADR-7NY2 item 10",
          "title": "Sidecar Sha256"
        },
        "size": {
          "description": "A size key of the `sizes` of the sidecar.",
          "live": false,
          "source": "ADR-7NY2 item 10",
          "title": "Size",
          "type": "string"
        }
      },
      "required": [
        "key",
        "size"
      ],
      "title": "DetectorParams",
      "type": "object"
    },
    "FirstOfNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "description": "A list of `<node>.<port>`, each with an optional `@prev`. At least one item.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        },
        "type": {
          "const": "first_of",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "FirstOfNode",
      "type": "object"
    },
    "FitnessCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "description": "The check. A check that fails asks for a new detection.",
          "enum": [
            "min_keypoint_score",
            "keypoints_within_bbox_ratio",
            "max_frames_without_redetect",
            "bbox_area_collapse"
          ],
          "title": "Check",
          "type": "string"
        },
        "expand_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bbox_area_collapse (1.10).",
          "title": "Expand Ratio"
        },
        "min_area_ratio": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bbox_area_collapse (0.25).",
          "title": "Min Area Ratio"
        },
        "min_score": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bbox_area_collapse (0.0).",
          "title": "Min Score"
        },
        "n_frames": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "max_frames_without_redetect (30).",
          "title": "N Frames"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "min_keypoint_score (0.3) or keypoints_within_bbox_ratio (0.5).",
          "title": "Threshold"
        }
      },
      "required": [
        "check"
      ],
      "title": "FitnessCheck",
      "type": "object"
    },
    "GateNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/GateParams"
        },
        "type": {
          "const": "gate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "GateNode",
      "type": "object"
    },
    "GateParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "Pass `value` when `condition` is empty, is present, or has a score greater than `threshold`.",
          "enum": [
            "is_empty",
            "is_present",
            "score_above"
          ],
          "live": false,
          "source": "ADR-7NY2 item 6",
          "title": "Mode",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The score threshold of the mode `score_above`.",
          "live": true,
          "source": "ADR-7NY2 item 6; ADR-88WQ item 6",
          "title": "Threshold"
        }
      },
      "required": [
        "mode"
      ],
      "title": "GateParams",
      "type": "object"
    },
    "Instrumentation": {
      "additionalProperties": false,
      "properties": {
        "taps": {
          "description": "The record and replay taps.",
          "items": {
            "$ref": "#/$defs/Tap"
          },
          "title": "Taps",
          "type": "array"
        },
        "timing_points": {
          "description": "`<node>.<point>` or `pipeline.run`. Empty: no timing point is on.",
          "items": {
            "type": "string"
          },
          "title": "Timing Points",
          "type": "array"
        }
      },
      "title": "Instrumentation",
      "type": "object"
    },
    "MediapipeTasksNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/MediapipeTasksParams"
        },
        "type": {
          "const": "mediapipe_tasks",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "MediapipeTasksNode",
      "type": "object"
    },
    "MediapipeTasksParams": {
      "additionalProperties": false,
      "properties": {
        "max_instances": {
          "default": 1,
          "description": "`num_poses`, `num_hands` or `num_faces`. Holistic is single person: 1.",
          "live": false,
          "minimum": 1,
          "source": "MediaPipe `num_poses`, `num_hands`, `num_faces` (Tasks default 1); ADR-48PG item 4",
          "title": "Max Instances",
          "type": "integer"
        },
        "min_detection_score": {
          "default": 0.5,
          "description": "The minimum detection score (Holistic: the pose and the face detection).",
          "live": false,
          "maximum": 1.0,
          "minimum": 0.0,
          "source": "MediaPipe `min_*_detection_confidence` (Tasks default 0.5)",
          "title": "Min Detection Score",
          "type": "number"
        },
        "min_presence_score": {
          "default": 0.5,
          "description": "The minimum presence score (Holistic: the landmark score of each part).",
          "live": false,
          "maximum": 1.0,
          "minimum": 0.0,
          "source": "MediaPipe `min_*_presence_confidence`, Holistic `min_*_landmarks_confidence` (Tasks default 0.5)",
          "title": "Min Presence Score",
          "type": "number"
        },
        "min_tracking_score": {
          "default": 0.5,
          "description": "The minimum tracking score in VIDEO mode. Holistic has no tracking option.",
          "live": false,
          "maximum": 1.0,
          "minimum": 0.0,
          "source": "MediaPipe `min_tracking_confidence` (Tasks default 0.5)",
          "title": "Min Tracking Score",
          "type": "number"
        },
        "size": {
          "default": "heavy",
          "description": "The model size of the pose landmarker. Only for the variant `body`.",
          "enum": [
            "lite",
            "full",
            "heavy"
          ],
          "live": false,
          "source": "MediaPipe asset `pose_landmarker_<size>`; MediapipePoseDetectorConfig.model_complexity",
          "title": "Size",
          "type": "string"
        },
        "variant": {
          "description": "The Tasks landmarker: pose (`body`), hand, face or holistic.",
          "enum": [
            "body",
            "hand",
            "face",
            "holistic"
          ],
          "live": false,
          "source": "ADR-48PG item 4; ADR-88WQ item 4",
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant"
      ],
      "title": "MediapipeTasksParams",
      "type": "object"
    },
    "MergeNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/MergeParams"
        },
        "type": {
          "const": "merge",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "MergeNode",
      "type": "object"
    },
    "MergeParams": {
      "additionalProperties": false,
      "properties": {
        "map": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Target point to slot column `<slot>.<point>`. A present slot point replaces the target point.",
          "live": false,
          "source": "ADR-7NY2 item 6",
          "title": "Map",
          "type": "object"
        },
        "max_distance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The largest anchor distance, as a part of the diagonal of the box around the present points of the target row. Empty: no limit.",
          "live": true,
          "source": "ADR-7NY2 item 6",
          "title": "Max Distance"
        },
        "slots": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Slot name to the target point that anchors the slot, for example `left_hand: body.left_wrist`.",
          "live": false,
          "minProperties": 1,
          "source": "ADR-7NY2 item 6",
          "title": "Slots",
          "type": "object"
        },
        "source_anchor": {
          "description": "The point of `source` that the node compares with the slot anchors, for example `hand.wrist`.",
          "live": false,
          "source": "ADR-7NY2 item 6",
          "title": "Source Anchor",
          "type": "string"
        }
      },
      "required": [
        "slots",
        "source_anchor"
      ],
      "title": "MergeParams",
      "type": "object"
    },
    "NoParams": {
      "additionalProperties": false,
      "description": "A node type with no params.",
      "properties": {},
      "title": "NoParams",
      "type": "object"
    },
    "RedetectNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/RedetectParams"
        },
        "type": {
          "const": "redetect",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "RedetectNode",
      "type": "object"
    },
    "RedetectParams": {
      "additionalProperties": false,
      "properties": {
        "fitness_checks": {
          "description": "Checks on the previous frame that ask for a new detection.",
          "items": {
            "$ref": "#/$defs/FitnessCheck"
          },
          "live": false,
          "source": "BBoxPolicyConfig.fitness_checks",
          "title": "Fitness Checks",
          "type": "array"
        },
        "redetect_interval": {
          "default": 1,
          "description": "Ask for a new detection at least each this many frames.",
          "live": true,
          "minimum": 1,
          "source": "BBoxPolicyConfig.redetect_interval",
          "title": "Redetect Interval",
          "type": "integer"
        }
      },
      "title": "RedetectParams",
      "type": "object"
    },
    "RoiFromPointsNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/RoiFromPointsParams"
        },
        "type": {
          "const": "roi_from_points",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "RoiFromPointsNode",
      "type": "object"
    },
    "RoiFromPointsParams": {
      "additionalProperties": false,
      "properties": {
        "alignment_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The end point of the alignment rule.",
          "live": false,
          "source": "ADR-7NY2 item 6",
          "title": "Alignment End"
        },
        "alignment_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The start point of the alignment rule.",
          "live": false,
          "source": "ADR-7NY2 item 6",
          "title": "Alignment Start"
        },
        "derived_points": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              }
            ]
          },
          "description": "Derived point name to derivation, in the map form of the sidecar `keypoint.derived_points`: passthrough, mean or weighted.",
          "live": false,
          "source": "ADR-7NY2 item 6; ADR-88WQ item 6",
          "title": "Derived Points",
          "type": "object"
        },
        "expand_ratio": {
          "default": 1.0,
          "description": "Multiply the width and the height by this value.",
          "exclusiveMinimum": 0.0,
          "live": true,
          "source": "MediaPipe RectTransformationCalculator scale default; ADR-88WQ item 4",
          "title": "Expand Ratio",
          "type": "number"
        },
        "points": {
          "description": "The points of the ROI. A list of names is one point with aliases: the first present name counts.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "live": false,
          "minItems": 1,
          "source": "ADR-7NY2 item 6",
          "title": "Points",
          "type": "array"
        },
        "score_threshold": {
          "default": 0.0,
          "description": "A point counts only when its score is greater than this value.",
          "live": true,
          "minimum": 0.0,
          "source": "ADR-7NY2 item 6; ADR-88WQ item 6",
          "title": "Score Threshold",
          "type": "number"
        },
        "shift_x": {
          "default": 0.0,
          "description": "Shift along the ROI x axis, in ROI widths.",
          "live": true,
          "source": "MediaPipe RectTransformationCalculator default",
          "title": "Shift X",
          "type": "number"
        },
        "shift_y": {
          "default": 0.0,
          "description": "Shift along the ROI y axis, in ROI heights.",
          "live": true,
          "source": "MediaPipe RectTransformationCalculator default",
          "title": "Shift Y",
          "type": "number"
        },
        "size_rule": {
          "default": "bounds",
          "description": "`bounds`: the box around the points. `alignment`: centre at the start point, size 2 \u00d7 the distance from start to end.",
          "enum": [
            "bounds",
            "alignment"
          ],
          "live": false,
          "source": "MediaPipe AlignmentPointsRectsCalculator; ADR-7NY2 item 6",
          "title": "Size Rule",
          "type": "string"
        },
        "square_long": {
          "default": false,
          "description": "Make the ROI square with its longer side.",
          "live": true,
          "source": "MediaPipe RectTransformationCalculator default",
          "title": "Square Long",
          "type": "boolean"
        },
        "target_rotation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The rotation target in degrees. Empty: rotation `none`, an axis-aligned ROI.",
          "live": false,
          "source": "MediaPipe rect rotation; ADR-7NY2 item 6",
          "title": "Target Rotation Deg"
        }
      },
      "required": [
        "points"
      ],
      "title": "RoiFromPointsParams",
      "type": "object"
    },
    "RoiTrackingNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "$ref": "#/$defs/RoiTrackingParams"
        },
        "type": {
          "const": "roi_tracking",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "RoiTrackingNode",
      "type": "object"
    },
    "RoiTrackingParams": {
      "additionalProperties": false,
      "properties": {
        "keypoint_margin": {
          "default": -0.1,
          "description": "Each previous point must be inside the new ROI grown by this part (negative: shrunk).",
          "live": true,
          "source": "MediaPipe Holistic hand RoiTrackingCalculator (face: -0.2)",
          "title": "Keypoint Margin",
          "type": "number"
        },
        "max_offset": {
          "default": 0.2,
          "description": "The largest x and y offset, as a part of the new ROI size.",
          "live": true,
          "minimum": 0.0,
