  "additionalProperties": false,
  "description": "One pipeline file: `<pipeline_id>.pipeline.yaml`.",
  "properties": {
    "description": {
      "default": "",
      "description": "A short text for people.",
      "title": "Description",
      "type": "string"
    },
    "instrumentation": {
      "$ref": "#/$defs/Instrumentation",
      "description": "Timing points and taps."
    },
    "nodes": {
      "description": "The nodes, in any order.",
      "items": {
        "discriminator": {
          "mapping": {
            "concat": "#/$defs/ConcatNode",
            "detector": "#/$defs/DetectorNode",
            "first_of": "#/$defs/FirstOfNode",
            "gate": "#/$defs/GateNode",
            "mediapipe_tasks": "#/$defs/MediapipeTasksNode",
            "merge": "#/$defs/MergeNode",
            "redetect": "#/$defs/RedetectNode",
            "roi_from_points": "#/$defs/RoiFromPointsNode",
            "roi_tracking": "#/$defs/RoiTrackingNode",
            "smooth_keypoints": "#/$defs/SmoothKeypointsNode",
            "smooth_roi": "#/$defs/SmoothRoiNode"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DetectorNode"
          },
          {
            "$ref": "#/$defs/MediapipeTasksNode"
          },
          {
            "$ref": "#/$defs/RoiFromPointsNode"
          },
          {
            "$ref": "#/$defs/RoiTrackingNode"
          },
          {
            "$ref": "#/$defs/GateNode"
          },
          {
            "$ref": "#/$defs/FirstOfNode"
          },
          {
            "$ref": "#/$defs/ConcatNode"
          },
          {
            "$ref": "#/$defs/MergeNode"
          },
          {
            "$ref": "#/$defs/SmoothKeypointsNode"
          },
          {
            "$ref": "#/$defs/SmoothRoiNode"
          },
          {
            "$ref": "#/$defs/RedetectNode"
          }
        ]
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Public output name to `<node>.<port>`, with no `@prev`.",
      "minProperties": 1,
      "title": "Outputs",
      "type": "object"
    },
    "pipeline_id": {
      "description": "The id of the pipeline. The file name is `<pipeline_id>.pipeline.yaml`.",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Pipeline Id",
      "type": "string"
    },
    "schema_version": {
      "description": "The pipeline spec version, in SemVer, in quotes.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source",
      "description": "The source of the file, as the sidecar `source`: `{name, version}`."
    }
  },
  "required": [
    "schema_version",
    "pipeline_id",
    "source",
    "nodes",
    "outputs"
  ],
  "title": "PipelineConfig",
  "type": "object"
}
