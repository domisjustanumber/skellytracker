    "SmoothRoiNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id. `pipeline` and `frame` are reserved.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input name to `<node>.<port>`, with an optional `@prev`.",
          "title": "Inputs",
          "type": "object"
        },
