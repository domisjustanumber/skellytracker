    "SmoothKeypointsParams": {
      "additionalProperties": false,
      "properties": {
        "beta": {
          "default": 0.0,
          "description": "one_euro: the speed coefficient, in Hz per px/s.",
          "live": true,
          "minimum": 0.0,
          "source": "KeypointSmoothingConfig",
          "title": "Beta",
          "type": "number"
        },
        "d_cutoff": {
          "default": 1.0,
          "description": "one_euro: the cutoff frequency of the derivative, in Hz.",
          "exclusiveMinimum": 0.0,
          "live": true,
          "source": "KeypointSmoothingConfig",
          "title": "D Cutoff",
          "type": "number"
        },
        "filter": {
          "default": "one_euro",
          "description": "The filter.",
          "enum": [
            "one_euro",
            "kalman"
          ],
          "live": false,
          "source": "KeypointSmoothingConfig.kind",
          "title": "Filter",
          "type": "string"
        },
        "max_gap_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hold the last value of a missing point for this many milliseconds after its last detection. Empty: no hold.",
          "live": false,
          "source": "KeypointSmoothingConfig.max_gap_frames",
          "title": "Max Gap Ms"
        },
        "max_velocity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refuse a point that moves faster than this many pixels per second since its last detection. Empty: accept each point.",
          "live": true,
          "source": "KeypointSmoothingConfig",
          "title": "Max Velocity"
        },
        "measurement_noise": {
          "default": 10.0,
          "description": "kalman: the measurement noise, in px\u00b2.",
          "exclusiveMinimum": 0.0,
          "live": true,
          "source": "KalmanKeypointSmoothingConfig",
          "title": "Measurement Noise",
          "type": "number"
        },
        "min_cutoff": {
          "default": 1.0,
          "description": "one_euro: the minimum cutoff frequency, in Hz.",
          "exclusiveMinimum": 0.0,
          "live": true,
          "source": "KeypointSmoothingConfig",
          "title": "Min Cutoff",
          "type": "number"
        },
        "process_noise_pos": {
          "default": 30.0,
          "description": "kalman: the process noise of the position, in px\u00b2 per second.",
          "exclusiveMinimum": 0.0,
          "live": true,
          "source": "KalmanKeypointSmoothingConfig (1 px\u00b2 per frame at 30 fps)",
          "title": "Process Noise Pos",
          "type": "number"
        },
        "process_noise_vel": {
          "default": 2700.0,
          "description": "kalman: the process noise of the velocity, in (px/s)\u00b2 per second.",
          "exclusiveMinimum": 0.0,
          "live": true,
          "source": "KalmanKeypointSmoothingConfig (0.1 (px/frame)\u00b2 per frame at 30 fps)",
          "title": "Process Noise Vel",
          "type": "number"
        },
        "reset_after_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
